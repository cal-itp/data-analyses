{
  "name": "Cal-ITP Data Analyses (Nix + DinD)",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/nix:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers-community/features/direnv:1": {
       "version": "latest"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:4.0.0": {
      "version": "latest",
      "moby": true
    }
  },
   "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/devcontainer_ssl,target=/home/ssl_certs,type=bind,consistency=cached"
  ],
  "onCreateCommand": "sudo sh -c 'for c in CTROOTCA01 CTISSUINGCA01 CTISSUINGCA02; do src=/home/ssl_certs/$c.pem; [ -f \"$src\" ] || src=/home/ssl_certs/$c.cer; [ -f \"$src\" ] && sed \"s/\\r$//\" \"$src\" > /usr/local/share/ca-certificates/$c.cer; done && update-ca-certificates' && sudo mkdir -p /etc/nix && echo 'experimental-features = nix-command flakes' | sudo tee -a /etc/nix/nix.conf && if [ -x $(command -v zsh) ]; then sudo mkdir -p /etc/zsh && echo 'eval \"$(direnv hook zsh)\"' | sudo tee -a /etc/zsh/zshrc; fi && if [ -x $(command -v fish) ]; then sudo mkdir -p /etc/fish/conf.d && echo 'direnv hook fish | source' | sudo tee /etc/fish/conf.d/direnv.fish; fi",
  "postStartCommand": "direnv allow",
  "containerEnv": {
    "LC_ALL": "C.UTF-8",
    "LANG": "C.UTF-8",
    "TZ": "America/Los_Angeles",
    "SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.cer",
    "REQUESTS_CA_BUNDLE": "/etc/ssl/certs/ca-certificates.cer",
    "GRPC_DEFAULT_SSL_ROOTS_FILE_PATH": "/etc/ssl/certs/ca-certificates.cer",
    "NIX_SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.cer"
  },
  "forwardPorts": [
    8080
  ],
  "portsAttributes": {
    "8080": {
      "label": "Airflow UI",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "editor.formatOnSave": true,
      "files.trimTrailingWhitespace": true,
      "files.insertFinalNewline": true,
      "files.encoding": "utf8",
      "files.eol": "\n",
      "settings": {
        "dev.containers.dockerCredentialHelper": false
      },
      "extensions": [
        "jnoortheen.nix-ide",
        "mkhl.direnv",
        "ms-python.python",
        "ms-toolsai.jupyter",
        "tamasfe.even-better-toml",
        "ms-azuretools.vscode-docker",
        "davidanson.vscode-markdownlint",
        "bierner.markdown-mermaid",
        "mhutchie.git-graph"
      ]
    }
  }
}
